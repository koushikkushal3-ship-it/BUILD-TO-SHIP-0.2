# Public values only — these are safe to ship in the client bundle.
# The Supabase anon key is meant to be public; real data access is protected by RLS + the backend API.
# Still keep the real values in .env (gitignored), not here — otherwise anyone
# cloning the repo points at your Supabase project by default.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend origin. The /api suffix is optional — the client appends it if missing.
VITE_API_BASE_URL=http://localhost:4000/api
