# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini (platform default key, used when a user has no BYOK key)
GEMINI_API_KEY=your-gemini-api-key
# Optional — override if a newer model id is available
GEMINI_MODEL=gemini-3.5-flash

# YouTube Data API v3 (for the resource-recommendation engine)
YOUTUBE_API_KEY=your-youtube-api-key

# BYOK envelope-encryption master secret (32+ random bytes, base64). Never commit the real value.
ENCRYPTION_SECRET=replace-with-a-long-random-base64-string

# CORS origin for the deployed frontend
FRONTEND_URL=http://localhost:5173

PORT=4000
