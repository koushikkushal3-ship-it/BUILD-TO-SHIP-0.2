# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini (platform default key, used when a user has no BYOK key)
GEMINI_API_KEY=your-gemini-api-key
# Optional — override if a newer model id is available (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# YouTube Data API v3 (for the resource-recommendation engine)
YOUTUBE_API_KEY=your-youtube-api-key

# BYOK envelope-encryption master secret (32+ random bytes, base64). Never commit the real value.
ENCRYPTION_SECRET=replace-with-a-long-random-base64-string

# CORS origin for the deployed frontend
FRONTEND_URL=http://localhost:5173

PORT=4000

# News APIs (Dashboard/News page industry feed) — tried in this order, each
# a fallback for the previous one's free-tier quota running out. All optional;
# the industry feed just returns fewer results if some are unset.
GNEWS_API_KEY=your-gnews-api-key
NEWSDATA_API_KEY=your-newsdata-api-key
CURRENTS_API_KEY=your-currents-api-key
MEDIASTACK_API_KEY=your-mediastack-api-key
